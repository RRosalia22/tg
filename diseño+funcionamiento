# ---------------------------
# Rebanado (reproducción y extracción de linea vs tiempo)
# ---------------------------
def rebanado2():
    global line_coords, video_running, file_path, pixels_frame, fig, canvas, ax

    if not file_path:
        print("No se ha seleccionado ningún video.")
        return

    cap = cv2.VideoCapture(file_path)
    if not cap.isOpened():
        print("No se pudo abrir el video.")
        return

    video_running = True
    pixels_frame = []  # reiniciar lista al comenzar

    def actualizar_frame():
        nonlocal cap
        global video_running, pixels_frame, fig, canvas, ax

        if not video_running:
            cap.release()
            return

        ret, frame = cap.read()
        if not ret:
            print("Fin del video.")
            cap.release()
            mostrar_img_final()
            return

        frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)

        # Mostrar el frame en el canvas
        fig.clf()
        ax = fig.add_subplot(111)
        ax.imshow(frame_rgb)
        ax.axis('off')
        ax.set_title("Video")
        canvas.draw()

        # Extraer valores de los píxeles si hay línea
        if line_coords:
            fila_pixeles = []
            for x, y in line_coords:
                if 0 <= y < frame_rgb.shape[0] and 0 <= x < frame_rgb.shape[1]:
                    fila_pixeles.append(frame_rgb[y, x])
            if fila_pixeles:
                pixels_frame.append(fila_pixeles)
        else:
            # Si no hay línea definida, solo se muestra el video pero no se extrae
            pass

        # Programar la siguiente llamada (aprox 30ms -> ~33 FPS)
        canvas.get_tk_widget().after(30, actualizar_frame)

    # iniciar loop de actualización
    actualizar_frame()

# Mostrar resultado final (imagen línea vs tiempo)
def mostrar_img_final():
    global pixels_frame
    if not pixels_frame:
        print("No hay datos para mostrar.")
        return

    resultado = np.array(pixels_frame, dtype=np.uint8)  # (num_frames, num_pixeles, 3)

    # Mostrar en ventana nueva de matplotlib
    plt.figure("Imagen Línea vs Tiempo")
    plt.imshow(resultado)
    #plt.axis('off')
    plt.title("Concatenación de Píxeles (Línea vs Tiempo)")
    plt.show()

    # # Guardar imagen
    # output_path = "linea_vs_tiempo.png"
    # plt.imsave(output_path, resultado)
    # print(f"Imagen guardada como '{output_path}'")
        # Pedir al usuario la ruta de guardado
    output_path = filedialog.asksaveasfilename(
        title="Guardar imagen",
        defaultextension=".png",
        filetypes=[("PNG files", "*.png"), ("All files", "*.*")]
    )

    if output_path:  # si el usuario no canceló
        plt.imsave(output_path, resultado)
        print(f"Imagen guardada como '{output_path}'")
    else:
        print("Guardado cancelado por el usuario.")

