# ---------------------------
# Funciones de interacción
# ---------------------------

def bresenham_line(x0, y0, x1, y1):
    x0, y0, x1, y1 = int(round(x0)), int(round(y0)), int(round(x1)), int(round(y1))
    points = []
    dx = abs(x1 - x0)
    dy = abs(y1 - y0)
    x, y = x0, y0
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1

    if dx > dy:
        err = dx / 2.0
        while x != x1:
            points.append((x, y))
            err -= dy
            if err < 0:
                y += sy
                err += dx
            x += sx
    else:
        err = dy / 2.0
        while y != y1:
            points.append((x, y))
            err -= dx
            if err < 0:
                x += sx
                err += dy
            y += sy

    points.append((x1, y1))
    return points

# Maneja clics sobre la figura (matplotlib)
def on_click(event):
    global ax, selected_points, point_artists, canvas

    if event.inaxes:
        # Si ya tenemos 2 puntos, limpiamos para permitir otra selección
        if len(selected_points) == 2:
            selected_points.clear()
            for artist in point_artists:
                try:
                    artist.remove()
                except Exception:
                    pass
            point_artists.clear()
            # remover líneas previas
            if ax:
                for line in list(ax.lines):
                    try:
                        line.remove()
                    except Exception:
                        pass
        # Guardar punto y dibujarlo
        selected_points.append((event.xdata, event.ydata))
        print(f"Seleccionado: ({event.xdata:.2f}, {event.ydata:.2f})")
        point = event.inaxes.plot(event.xdata, event.ydata, 'ro')[0]
        point_artists.append(point)
        canvas.draw()

# Maneja tecla Enter: si hay 2 puntos, dibuja línea y calcula coordenadas con Bresenham
def on_enter(event):
    global ax, selected_points, line_coords, canvas
    if len(selected_points) >= 2:
        # tomar los dos últimos puntos
        x_vals = [selected_points[-2][0], selected_points[-1][0]]
        y_vals = [selected_points[-2][1], selected_points[-1][1]]
        # dibujar línea
        ax.plot(x_vals, y_vals, 'g--')
        canvas.draw()
        # calcular coordenadas enteras de la línea
        line_coords = bresenham_line(x_vals[0], y_vals[0], x_vals[1], y_vals[1])
        print(f"Dibujando línea entre {selected_points[-2]} y {selected_points[-1]}")
        print(f"Se definieron {len(line_coords)} coordenadas para el rebanado.")

