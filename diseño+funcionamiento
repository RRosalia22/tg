def seleccionar_video():
    global file_path
    ruta = filedialog.askopenfilename(
        title="Seleccionar video",
        filetypes=[("Archivos de video", "*.mp4 *.avi *.mov *.mkv")]
    )
    if ruta:
        file_path = ruta
        cargar_primer_frame_y_mostrar_principal()

def cargar_primer_frame_y_mostrar_principal():
    global file_path, fig, ax, canvas
    if not file_path:
        return

    cap = cv2.VideoCapture(file_path)
    ret, frame = cap.read()
    cap.release()

    if ret:
        frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)

        # Mostrar el primer frame en la figura (sin destruir la interfaz de control)
        fig.clf()
        ax = fig.add_subplot(111)
        ax.imshow(frame_rgb)
        ax.axis('off')
        ax.set_title("Primer Frame del Video")
        canvas.draw()
    else:
        print("No se pudo leer el primer frame.")

    mostrar_pantalla_principal()  # mostrar controles principales

